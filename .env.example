# ============================================================================
# AITestPlatform 环境变量模板
#
# 使用方法: 复制本文件为 .env，填入你的实际配置
#   cp .env.example .env
#
# 标记 [必填] 的配置项必须填写，否则服务无法启动
# 标记 [可选] 的配置项可以不填，会使用默认值或跳过该功能
# ============================================================================

# ---------------------------------------------------------------------------
# RAG 知识库服务
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='MyRAG'
WEBUI_DESCRIPTION="RAG"
PARSE_METHOD=ocr
TIKTOKEN_CACHE_DIR=./data/rag/temp/tiktoken

SUMMARY_LANGUAGE=Chainese
ENABLE_LLM_CACHE_FOR_EXTRACT=true

MAX_ASYNC=4
MAX_PARALLEL_INSERT=2

# ---------------------------------------------------------------------------
# LLM 大模型配置 [必填]
# 支持 OpenAI 兼容接口（OpenAI / DeepSeek / SiliconFlow / 本地 Ollama 等）
# ---------------------------------------------------------------------------
LLM_BINDING=openai
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_BINDING_HOST=https://api.siliconflow.cn/v1
LLM_BINDING_API_KEY=your-llm-api-key-here

# ---------------------------------------------------------------------------
# Embedding 向量模型配置 [必填]
# ---------------------------------------------------------------------------
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_BINDING_API_KEY=your-embedding-api-key-here

# ---------------------------------------------------------------------------
# Rerank 重排序模型 [可选]
# ---------------------------------------------------------------------------
ENABLE_RERANK=True
MIN_RERANK_SCORE=0.6
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_BINDING_HOST=https://api.siliconflow.cn/v1/rerank
RERANK_BINDING_API_KEY=your-rerank-api-key-here

# ---------------------------------------------------------------------------
# Visual 多模态模型 [可选]
# ---------------------------------------------------------------------------
VISUAL_BINDING=openai
VISUAL_MODEL=Qwen/Qwen3.5-9B
VISUAL_BINDING_HOST=https://api.siliconflow.cn/v1/chat/completions
VISUAL_BINDING_API_KEY=your-visual-api-key-here

# ---------------------------------------------------------------------------
# RAG Server [必填]
# 知识库服务地址，与上方 HOST/PORT 对应
# ---------------------------------------------------------------------------
RAG_SERVER_URL=http://127.0.0.1:9621
RAG_API_KEY=your-rag-api-key-here

# ---------------------------------------------------------------------------
# Database [必填]
# MySQL 连接串，格式: mysql://用户:密码@地址:端口/数据库名
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://root:your-password@127.0.0.1:3306/aiTestPlatform

# ---------------------------------------------------------------------------
# JWT 认证 [必填]
# ⚠️ JWT_SECRET_KEY 必须修改！可用以下命令生成:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=please-generate-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Redis [可选]
# 用于 Token 黑名单（用户登出后 token 立即失效）
# 不配置时该功能静默跳过，不影响核心业务
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# 部署配置（服务器部署 / Nginx 反向代理）
# ---------------------------------------------------------------------------
# 后端监听地址。Nginx 反向代理时保持 127.0.0.1 即可（仅本机可达）
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# CORS 允许的前端域名，逗号分隔。同域 Nginx 部署留空即可
# 分域部署示例: CORS_ORIGINS=https://frontend.example.com
CORS_ORIGINS=
# 日志文件路径，留空则仅输出到控制台
LOG_FILE=logs/backend.log
