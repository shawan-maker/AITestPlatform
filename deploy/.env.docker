# ============================================================================
# AITestPlatform Docker Compose 部署环境变量
#
# 使用方法:
#   cp .env.docker .env
#   vim .env    # 修改标记为 [必改] 的配置项
#
# 此文件专为 Docker Compose 部署设计。
# docker-compose.yml 会自动构建 DATABASE_URL 和 REDIS_URL（使用容器内部网络），
# 因此无需手动指定这两项。
# ============================================================================

# ---------------------------------------------------------------------------
# Docker Compose 服务配置
# ---------------------------------------------------------------------------
# MySQL root 密码 [必改]
MYSQL_ROOT_PASSWORD=aitest2026
# 数据库名
MYSQL_DATABASE=aiTestPlatform
# 外部暴露端口（如服务器已有 MySQL 占用 3306，可改为其他端口）
MYSQL_PORT=3306
REDIS_PORT=6379
# 前端 HTTP 端口 [必改]（如 80 被占用可改为 8080 等）
HTTP_PORT=80

# ---------------------------------------------------------------------------
# RAG 知识库服务
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='AITestPlatform RAG'
WEBUI_DESCRIPTION="RAG"
PARSE_METHOD=ocr
TIKTOKEN_CACHE_DIR=./data/rag/temp/tiktoken
SUMMARY_LANGUAGE=Chainese
ENABLE_LLM_CACHE_FOR_EXTRACT=true
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2

# ---------------------------------------------------------------------------
# LLM 大模型配置 [必改]
# 支持 OpenAI 兼容接口（OpenAI / DeepSeek / SiliconFlow / 本地 Ollama 等）
# ---------------------------------------------------------------------------
LLM_BINDING=openai
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_BINDING_HOST=https://api.siliconflow.cn/v1
LLM_BINDING_API_KEY=your-llm-api-key-here

# ---------------------------------------------------------------------------
# Embedding 向量模型配置 [必改]
# ---------------------------------------------------------------------------
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_BINDING_API_KEY=your-embedding-api-key-here

# ---------------------------------------------------------------------------
# Rerank 重排序模型 [可选]
# ---------------------------------------------------------------------------
ENABLE_RERANK=True
MIN_RERANK_SCORE=0.6
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_BINDING_HOST=https://api.siliconflow.cn/v1/rerank
RERANK_BINDING_API_KEY=your-rerank-api-key-here

# ---------------------------------------------------------------------------
# Visual 多模态模型 [可选]
# ---------------------------------------------------------------------------
VISUAL_BINDING=openai
VISUAL_MODEL=Qwen/Qwen3.5-9B
VISUAL_BINDING_HOST=https://api.siliconflow.cn/v1/chat/completions
VISUAL_BINDING_API_KEY=your-visual-api-key-here

# ---------------------------------------------------------------------------
# RAG Server [必改]
# 知识库服务地址。
# - 如果 RAG 服务部署在同一台服务器：使用 http://宿主机IP:9621
# - 如果 RAG 服务在其他服务器：填写实际地址
# ---------------------------------------------------------------------------
RAG_SERVER_URL=http://127.0.0.1:9621
RAG_API_KEY=your-rag-api-key-here

# ---------------------------------------------------------------------------
# JWT 认证 [必改]
# 生成安全密钥: python3 -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=please-generate-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# 部署配置
# ---------------------------------------------------------------------------
# Docker 部署中后端监听 0.0.0.0（容器内部，由 docker-compose 覆盖）
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# CORS：同域 Nginx 部署留空
CORS_ORIGINS=
# 日志：Docker 容器内输出到控制台，留空即可
LOG_FILE=
