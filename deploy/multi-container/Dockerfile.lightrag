# ============================================================================
# LightRAG Server Dockerfile
# 构建: docker build -f deploy/multi-container/Dockerfile.lightrag -t aitestplatform-lightrag .
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# 安装 LightRAG Server（含 API 模块）
RUN pip install --no-cache-dir "lightrag-hku[api]"

# tiktoken 缓存目录
ENV TIKTOKEN_CACHE_DIR=/app/temp/tiktoken

EXPOSE 9621

CMD ["lightrag-server"]
