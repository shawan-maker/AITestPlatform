# ============================================================================
# AITestPlatform 前端 Dockerfile（多阶段构建）
# 阶段1: Node 构建 Vue 应用
# 阶段2: Nginx 提供静态文件服务
# 构建: docker build -f deploy/multi-container/Dockerfile.frontend -t aitestplatform-frontend .
# ============================================================================

# ---------- 阶段1: 构建 ----------
FROM node:18-alpine AS builder

WORKDIR /build

# 先复制 package 文件，利用 Docker 缓存
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# 复制前端代码
COPY frontend/ .

# 构建生产版本
RUN npm run build

# ---------- 阶段2: Nginx 服务 ----------
FROM nginx:alpine

# 删除默认配置
RUN rm /etc/nginx/conf.d/default.conf

# 复制自定义 Nginx 配置
COPY deploy/multi-container/nginx-docker.conf /etc/nginx/conf.d/default.conf

# 从构建阶段复制产物
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
