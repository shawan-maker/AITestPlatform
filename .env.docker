# ============================================================================
# AITestPlatform Docker 部署环境变量
#
# 使用方法: cp .env.docker .env && vim .env
#
# 与 .env.example 的区别:
#   - DATABASE_URL 指向 Docker 内部 mysql 容器（不是 127.0.0.1）
#   - REDIS_URL 指向 Docker 内部 redis 容器
#   - BACKEND_HOST=0.0.0.0（容器内必须监听所有接口）
#   - CORS_ORIGINS 留空（Nginx 同域代理）
#
# docker-compose.yml 会覆盖 DATABASE_URL 和 REDIS_URL，
# 此处仅为 init_deploy.py 等脚本在容器外使用时的参考值。
# ============================================================================

# ---------------------------------------------------------------------------
# RAG 知识库服务（独立部署，不在 Docker Compose 内）
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='MyRAG'
WEBUI_DESCRIPTION="RAG"
PARSE_METHOD=ocr
TIKTOKEN_CACHE_DIR=./data/rag/temp/tiktoken

SUMMARY_LANGUAGE=Chainese
ENABLE_LLM_CACHE_FOR_EXTRACT=true

MAX_ASYNC=4
MAX_PARALLEL_INSERT=2

# ---------------------------------------------------------------------------
# LLM 大模型配置 [必填]
# ---------------------------------------------------------------------------
LLM_BINDING=openai
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_BINDING_HOST=https://api.siliconflow.cn/v1
LLM_BINDING_API_KEY=your-llm-api-key-here

# ---------------------------------------------------------------------------
# Embedding 向量模型配置 [必填]
# ---------------------------------------------------------------------------
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_BINDING_API_KEY=your-embedding-api-key-here

# ---------------------------------------------------------------------------
# Rerank 重排序模型 [可选]
# ---------------------------------------------------------------------------
ENABLE_RERANK=True
MIN_RERANK_SCORE=0.6
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_BINDING_HOST=https://api.siliconflow.cn/v1/rerank
RERANK_BINDING_API_KEY=your-rerank-api-key-here

# ---------------------------------------------------------------------------
# Visual 多模态模型 [可选]
# ---------------------------------------------------------------------------
VISUAL_BINDING=openai
VISUAL_MODEL=Qwen/Qwen3.5-9B
VISUAL_BINDING_HOST=https://api.siliconflow.cn/v1/chat/completions
VISUAL_BINDING_API_KEY=your-visual-api-key-here

# ---------------------------------------------------------------------------
# RAG Server [必填]
# ---------------------------------------------------------------------------
RAG_SERVER_URL=http://your-rag-server:9621
RAG_API_KEY=your-rag-api-key-here

# ---------------------------------------------------------------------------
# Database [Docker Compose 会自动覆盖，此处为参考]
# mysql 容器名即为 hostname，密码与 docker-compose.yml 中 MYSQL_ROOT_PASSWORD 一致
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://root:aitest2026@mysql:3306/aiTestPlatform

# ---------------------------------------------------------------------------
# JWT 认证 [必填]
# 生产环境必须修改! 生成命令:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=please-generate-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Redis [Docker Compose 会自动覆盖，此处为参考]
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# 部署配置
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=
LOG_FILE=

# ---------------------------------------------------------------------------
# Docker Compose 专属配置
# ---------------------------------------------------------------------------
# MySQL root 密码（docker-compose.yml 读取此值）
MYSQL_ROOT_PASSWORD=aitest2026
MYSQL_DATABASE=aiTestPlatform
# 对外暴露端口（宿主机映射，生产可改为非标准端口）
MYSQL_PORT=3306
REDIS_PORT=6379
HTTP_PORT=80
