# 虚拟环境
venv/
.venv/

# 环境变量与密钥
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 测试目录（含 smoke tests、other 等不上传的文件）
tests/

# 示例/学习代码（不上传）
demo/

# Jupyter checkpoint
.ipynb_checkpoints/

# IDE
.idea/
.vscode/

# 设计文档
service/design/

# 本地数据/缓存（运行时生成，不提交）
data/
temp/
*.log
debug_*.log

# 部署产物（打包文件、数据库备份）
deploy/*.tar.gz
deploy/backup*.json
deploy/backup*.sql

# Frontend 测试
frontend/test-results/
frontend/playwright-report/
